# Required production origins. HTTPS is mandatory outside the test suite.
BLOGGER_PUBLIC_ORIGIN=https://sportmassagefuengirola.com
BLOGGER_STUDIO_HANDOFF_ENABLED=false

# Direct credentials are Blogger-only. Generate the hash without putting the password in shell history:
# read -rs BLOGGER_PASSWORD; printf '%s' "$BLOGGER_PASSWORD" | node scripts/generate-blogger-password-hash.mjs; unset BLOGGER_PASSWORD
BLOGGER_DIRECT_USERNAME=
BLOGGER_DIRECT_PASSWORD_HASH=

# Use a random value of at least 32 characters with mixed character classes.
BLOGGER_SESSION_SECRET=

# These paths must remain inside the project root and content must be persistent.
BLOGGER_STATE_DIR=.blogger-state
BLOGGER_CONTENT_ROOT=content/blog
BLOGGER_MEDIA_ROOT=content/blog/media
BLOGGER_OUTPUT_ROOT=.blogger-state/public

BLOGGER_SESSION_TTL_SECONDS=28800
# Used only when the user explicitly selects “Recordarme en este dispositivo”.
BLOGGER_REMEMBERED_SESSION_TTL_SECONDS=2592000
BLOGGER_LOGIN_MAX_ATTEMPTS=5
BLOGGER_BUILD_TIMEOUT_MS=120000
PORT=8787

# Analytics is fail-closed. Keep the independent verification gate false until the
# real production collector and site registration have been verified out of band.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
UMAMI_PRODUCTION_VERIFIED=false
