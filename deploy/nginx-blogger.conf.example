location = /admin/blogger/login {
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
}

location = /admin/blogger/launch {
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
}

location /admin/blogger/ {
    root /srv/sportmassage/current;
    try_files $uri $uri/ =404;
}

location ~ ^/(api/admin|api/blogger|api/posts|api/build|\.well-known/wf-blogger\.json) {
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 14m;
}
