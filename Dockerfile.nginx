FROM nginxinc/nginx-unprivileged:1.27-alpine

USER root
RUN mkdir -p /tmp/nginx/client_temp /tmp/nginx/proxy_temp /tmp/nginx/fastcgi_temp \
    /tmp/nginx/uwsgi_temp /tmp/nginx/scgi_temp \
  && chown -R 10001:10001 /tmp/nginx
COPY --chown=10001:10001 deploy/nginx-coolify.conf /etc/nginx/nginx.conf

USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/api/blogger/health || exit 1

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
